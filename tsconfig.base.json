{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@casino/game-engine": ["./libs/game-engine/src/index.ts"],
      "@casino/shared-types": ["./libs/shared-types/src/index.ts"],
      "@casino/ui": ["./libs/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
