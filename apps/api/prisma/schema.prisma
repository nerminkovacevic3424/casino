// Money is always BIGINT minor units (100 = 1.00 credit). Never floats.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PLAYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased and trimmed.
  email             String     @unique
  passwordHash      String     @map("password_hash")
  displayName       String     @map("display_name")
  dateOfBirth       DateTime   @map("date_of_birth") @db.Date
  role              Role       @default(PLAYER)
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  /// AES-256-GCM encrypted base32 secret (iv.tag.ciphertext, base64url).
  totpSecret        String?    @map("totp_secret")
  totpEnabledAt     DateTime?  @map("totp_enabled_at")
  /// Last accepted TOTP time step; codes at or before it are rejected (replay protection).
  totpLastTimeStep  Int?       @map("totp_last_time_step")
  failedLogins      Int        @default(0) @map("failed_logins")
  lockedUntil       DateTime?  @map("locked_until")
  /// Responsible play: no betting until this time (player-chosen break).
  coolOffUntil      DateTime?  @map("cool_off_until")
  /// Responsible play: account closed for play (and sign-in) until this time.
  selfExcludedUntil DateTime?  @map("self_excluded_until")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  wallet      Wallet?
  emailTokens EmailToken[]
  ledger      LedgerEntry[]
  seedPairs   SeedPair[]
  rounds      GameRound[]
  limits      PlayerLimits?
  favourites  Favourite[]

  @@map("users")
}

model Wallet {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @map("user_id") @db.Uuid
  /// CHECK (balance >= 0) is added in the migration.
  balance          BigInt    @default(0)
  lastDailyBonusAt DateTime? @map("last_daily_bonus_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger LedgerEntry[]

  @@map("wallets")
}

enum LedgerType {
  SIGNUP_BONUS
  DAILY_BONUS
  BET
  WIN
  REFUND
  ADJUSTMENT
  JACKPOT
}

/// Append-only: a trigger in the migration rejects UPDATE and DELETE.
model LedgerEntry {
  id           BigInt     @id @default(autoincrement())
  walletId     String     @map("wallet_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  type         LedgerType
  /// Signed: negative for debits, positive for credits.
  amount       BigInt
  balanceAfter BigInt     @map("balance_after")
  /// Game round this entry belongs to (bets, wins, refunds).
  roundId      String?    @map("round_id") @db.Uuid
  description  String?
  createdAt    DateTime   @default(now()) @map("created_at")

  wallet Wallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  round  GameRound? @relation(fields: [roundId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([roundId])
  @@map("ledger_entries")
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model EmailToken {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  /// SHA-256 of the token sent by email; the raw token is never stored.
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at")
  usedAt    DateTime?         @map("used_at")
  createdAt DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Provably fair seed pair. The server seed stays secret (only its SHA-256 is
/// shown) until the pair is rotated, then it is revealed for verification.
model SeedPair {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// 32 random bytes as hex, from the CSPRNG.
  serverSeed     String    @map("server_seed")
  serverSeedHash String    @map("server_seed_hash")
  clientSeed     String    @map("client_seed")
  /// Next nonce to use; incremented under a row lock for every round.
  nextNonce      Int       @default(0) @map("next_nonce")
  /// Exactly one active pair per user (partial unique index in the migration).
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  revealedAt     DateTime? @map("revealed_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  rounds GameRound[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("seed_pairs")
}

enum RoundStatus {
  OPEN
  SETTLED
}

/// One paid game round. Inputs + seeds fully determine the outcome.
model GameRound {
  id             String      @id @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  gameId         String      @map("game_id")
  seedPairId     String      @map("seed_pair_id") @db.Uuid
  nonce          Int
  status         RoundStatus
  /// Total staked (base bet plus doubles/splits/insurance), minor units.
  stake          BigInt
  payout         BigInt      @default(0)
  /// The player's choices (bet sizes, actions, holds) — replayable with the seeds.
  input          Json
  /// Client-safe outcome shown in history and on the verify page.
  result         Json?
  /// Server-only state for multi-step games (e.g. the blackjack shoe). Never sent to clients.
  state          Json?
  idempotencyKey String      @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at")
  settledAt      DateTime?   @map("settled_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  seedPair SeedPair      @relation(fields: [seedPairId], references: [id], onDelete: Restrict)
  ledger   LedgerEntry[]

  @@unique([userId, idempotencyKey])
  @@unique([seedPairId, nonce])
  @@index([userId, createdAt(sort: Desc)])
  @@index([gameId, createdAt])
  @@map("game_rounds")
}

/// Per-game switches managed from the admin panel.
model GameSetting {
  gameId    String   @id @map("game_id")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("game_settings")
}

/// Responsible-play limits (minor units / minutes). Lowering a limit applies
/// at once; raising or removing one only after a 24-hour cooling period
/// (the pending* fields), so it cannot be done on impulse.
model PlayerLimits {
  userId              String    @id @map("user_id") @db.Uuid
  dailyLossLimit      BigInt?   @map("daily_loss_limit")
  weeklyLossLimit     BigInt?   @map("weekly_loss_limit")
  monthlyLossLimit    BigInt?   @map("monthly_loss_limit")
  dailyWagerLimit     BigInt?   @map("daily_wager_limit")
  sessionLimitMinutes Int?      @map("session_limit_minutes")
  realityCheckMinutes Int?      @map("reality_check_minutes")
  /// JSON of limit changes that loosen limits, applied at pendingEffectiveAt.
  pending             Json?
  pendingEffectiveAt  DateTime? @map("pending_effective_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_limits")
}

model Favourite {
  userId    String   @map("user_id") @db.Uuid
  gameId    String   @map("game_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gameId])
  @@map("favourites")
}

/// Append-only record of every admin action (who did what to whom).
model AdminAction {
  id         BigInt   @id @default(autoincrement())
  adminId    String   @map("admin_id") @db.Uuid
  /// e.g. GAME_TOGGLE, USER_STATUS, BALANCE_ADJUST
  action     String
  targetUser String?  @map("target_user") @db.Uuid
  targetGame String?  @map("target_game")
  details    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([targetUser])
  @@map("admin_actions")
}
